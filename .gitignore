# BurstGPT cloned repo (fetched by setup.sh)
BurstGPT/

# Raw log timeseries (can be large)
logs/

# Python cache
__pycache__/
*.pyc
*.pyo

# Large dataset files (downloaded by setup.sh)
data/
.venv/

# Paper
paper-mlsys/
paper-pes-im/
paper-eenergy-old/
paper-eenergy-power-ramp/

# LaTeX build artifacts (paper-eenergy/ is tracked; keep .tex/.bib/.pdf, drop the rest)
paper-eenergy/*.aux
paper-eenergy/*.log
paper-eenergy/*.bbl
paper-eenergy/*.blg
paper-eenergy/*.out
paper-eenergy/*.fls
paper-eenergy/*.fdb_latexmk
paper-eenergy/*.synctex.gz

# macOS
.DS_Store
**/.DS_Store

# Documents (scratch notes for most experiment tracks; eenergy's are tracked deliverables).
# Use dir/* (not dir/) so git still descends far enough to see the negations below --
# a plain "dir/" pattern blocks traversal entirely and negations can't reach inside it.
findings/*
!findings/2026-08-31-eenergy-drf-lmetric-roundrobin-comparison.md
docs/*
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
docs/superpowers/specs/*
!docs/superpowers/specs/2026-08-30-eenergy-routing-design.md
!docs/superpowers/plans/
docs/superpowers/plans/*
!docs/superpowers/plans/2026-08-30-eenergy-routing-implementation.md

